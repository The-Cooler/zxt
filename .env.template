# 自学通 Docker 环境变量模板
# 使用方式：复制为 .env，然后填写标记为“必填”的内容。
# .env 是 Docker Compose、API 和 Worker 唯一的本地配置源，已被 .gitignore 忽略。
# 注意：变量值不要附加行尾注释，不要把真实密钥提交到版本库。

# ==============================================================================
# 一、启动必填
# ==============================================================================

# [必填] 至少配置一个模型供应商 API Key，否则后端会拒绝启动。
# 默认推荐硅基流动：https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=

# [必填] Neo4j 登录密码，同时用于 Neo4j 初始化、健康检查和后端连接。
# Neo4j 要求密码至少 8 个字符；已有数据目录不会因修改此值而自动重置密码。
NEO4J_PASSWORD=请替换为至少8位密码

# ==============================================================================
# 二、基础服务配置（都有默认值，首次启动通常无需修改）
# ==============================================================================

# [可选/默认 postgres] PostgreSQL 用户名。
POSTGRES_USER=postgres
# [可选/默认 postgres] PostgreSQL 密码。正式部署必须改成强密码。
POSTGRES_PASSWORD=postgres
# [可选/默认 zixuetong_know] PostgreSQL 数据库名。
# 后端连接串由 Compose 自动生成，不要再配置 POSTGRES_URL 或 POSTGRES_DATABASE。
POSTGRES_DB=zixuetong_know

# [可选/默认 neo4j] Neo4j 用户名。
NEO4J_USERNAME=neo4j

# [可选/默认 minioadmin] MinIO 对象存储访问账号。
MINIO_ACCESS_KEY=minioadmin
# [可选/默认 minioadmin] MinIO 对象存储访问密码。正式部署必须修改。
MINIO_SECRET_KEY=minioadmin

# [可选/默认 Asia/Shanghai] PostgreSQL 容器时区。
TZ=Asia/Shanghai

# ==============================================================================
# 三、本地目录与运行模式（都有默认值，通常无需修改）
# ==============================================================================

# [可选/默认 ./models] 宿主机本地模型目录，挂载到 API/Worker 的 /models。
MODEL_DIR=./models
# [可选/默认 /app/saves] API/Worker 容器内持久化目录。
# Compose 已将宿主机 ./saves 挂载到该位置，不建议修改。
SAVE_DIR=/app/saves
# [可选/默认 false] 轻量模式开关；true 会隐藏知识库/图谱接口和前端入口。
# 当前 Compose 仍会启动 Neo4j，因此该开关不用于减少容器数量。
LITE_MODE=false
# [可选/默认 0.6.2.beta] 本地构建镜像使用的版本标签。
ZIXUETONG_VERSION=0.6.2.beta

# ==============================================================================
# 四、模型供应商（按需填写；至少填写其中一个）
# ==============================================================================

# [按需] OpenAI。OPENAI_API_BASE 仅在使用兼容网关时填写。
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1

# [按需] 智谱 AI。
# ZHIPUAI_API_KEY=

# [按需] 阿里云百炼/通义千问。
# DASHSCOPE_API_KEY=

# [按需] DeepSeek。
# DEEPSEEK_API_KEY=

# [按需] 火山引擎方舟。
# ARK_API_KEY=

# [按需] MiniMax。
# MINIMAX_API_KEY=

# [按需] Together AI。
# TOGETHER_API_KEY=

# ==============================================================================
# 五、联网搜索（可选）
# ==============================================================================

# [按需] Tavily 搜索 API Key；不配置则不启用联网搜索。
# 获取地址：https://app.tavily.com/
TAVILY_API_KEY=

# ==============================================================================
# 六、容器内部服务地址（都有默认值，仅外接服务时修改）
# ==============================================================================

# [可选/默认 redis://redis:6379/0] 任务队列和运行事件使用的 Redis。
REDIS_URL=redis://redis:6379/0
# [可选/默认 http://minio:9000] API 访问 MinIO 的容器内地址。
MINIO_URI=http://minio:9000
# [可选/固定 bolt://graph:7687] API 访问 Neo4j 的容器内地址。
NEO4J_URI=bolt://graph:7687
# [可选/默认 PGVectorStorage] LightRAG 向量存储实现。
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
# [可选/默认 http://paddlex:8080] PaddleX OCR 服务地址；仅启用 all profile 时可用。
PADDLEX_URI=http://paddlex:8080
# [可选] 宿主机可访问地址；为空时由程序按当前环境处理。
HOST_IP=

# ==============================================================================
# 七、Sandbox（可选高级配置，默认值可直接运行）
# ==============================================================================

# [可选/固定 provisioner] API 使用的沙盒提供方式；当前只支持 provisioner。
SANDBOX_PROVIDER=provisioner
# [可选/默认 http://sandbox-provisioner:8002] API 访问 provisioner 的容器内地址。
SANDBOX_PROVISIONER_URL=http://sandbox-provisioner:8002
# [可选/默认 /home/gem/user-data] 智能体在沙盒中看到的用户数据根目录。
SANDBOX_VIRTUAL_PATH_PREFIX=/home/gem/user-data
# [可选/默认 180] 单次沙盒命令最长执行秒数。
SANDBOX_EXEC_TIMEOUT_SECONDS=180
# [可选/默认 262144] 单次沙盒命令最大输出字节数。
SANDBOX_MAX_OUTPUT_BYTES=262144
# [可选/默认 30] API 向沙盒发送保活请求的间隔秒数。
SANDBOX_KEEPALIVE_INTERVAL_SECONDS=30

# [可选/默认 docker] provisioner 后端：docker、memory 或 kubernetes。
SANDBOX_PROVISIONER_BACKEND=docker
# [可选] 创建的沙盒容器镜像。
SANDBOX_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:latest
# [可选/默认 8080] 沙盒容器内部服务端口。
SANDBOX_CONTAINER_PORT=8080
# [可选/默认 300] 等待新沙盒健康的最长秒数。
SANDBOX_HEALTH_TIMEOUT_SECONDS=300
# [可选/默认 120] 沙盒空闲多少秒后回收。
SANDBOX_IDLE_TIMEOUT_SECONDS=120
# [可选/默认 10] provisioner 检查空闲沙盒的间隔秒数。
SANDBOX_IDLE_CHECK_INTERVAL_SECONDS=10
# [可选/默认 http://agent-sandbox:8000] memory 后端的沙盒地址模板。
MEMORY_SANDBOX_URL_TEMPLATE=http://agent-sandbox:8000

# [按需] 仅当沙盒容器拉取镜像或联网需要代理时填写。
# SANDBOX_HTTP_PROXY=http://host.docker.internal:7897
# SANDBOX_HTTPS_PROXY=http://host.docker.internal:7897

# [可选/默认 zixuetong-know_app-network] Docker 沙盒加入的网络；同时也是 Compose 网络名。
SANDBOX_DOCKER_NETWORK=zixuetong-know_app-network
# [按需] 沙盒线程目录对应的宿主机绝对路径；留空使用默认挂载策略。
SANDBOX_DOCKER_THREADS_HOST_PATH=
# [可选/默认 zixuetong-sandbox] 创建的沙盒容器名称前缀。
SANDBOX_DOCKER_SANDBOX_PREFIX=zixuetong-sandbox
# [可选/默认 host.docker.internal] Docker 沙盒回连宿主机时使用的地址。
SANDBOX_DOCKER_SANDBOX_HOST=host.docker.internal

# [以下仅 kubernetes 后端使用]
# SANDBOX_K8S_NAMESPACE=zixuetong-know
# SANDBOX_NODE_HOST=host.docker.internal
# KUBECONFIG_PATH=/root/.kube/config
# THREAD_PVC=zixuetong-thread
# SKILLS_PVC=zixuetong-skills

# ==============================================================================
# 八、运行队列与 LightRAG 调优（可选，通常无需修改）
# ==============================================================================

# [可选/默认 1800] 取消运行信号在 Redis 中保留的秒数。
RUN_CANCEL_KEY_TTL_SECONDS=1800
# [可选/默认 7200] 运行事件流在 Redis 中保留的秒数。
RUN_EVENTS_STREAM_TTL_SECONDS=7200
# [可选/默认 0] Redis 事件流最大长度；0 表示不按长度裁剪。
RUN_EVENTS_STREAM_MAXLEN=0
# [可选/默认 600] 嵌入请求超时秒数。
EMBEDDING_TIMEOUT=600
# [可选/默认 600] 大模型请求超时秒数。
LLM_TIMEOUT=600
# [可选] LightRAG 大模型并发上限。
# MAX_ASYNC=5
# [可选] LightRAG 嵌入并发上限。
# EMBEDDING_FUNC_MAX_ASYNC=8
# [可选/默认 English] LightRAG 摘要语言，例如 Chinese。
# SUMMARY_LANGUAGE=Chinese

# ==============================================================================
# 九、Langfuse 可观测性（按需启用）
# ==============================================================================

# [可选/默认 false] 是否向 Langfuse 上报模型调用链路。
LANGFUSE_ENABLED=false
# [启用 Langfuse 时必填] Langfuse 项目公钥和私钥。
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# [可选/默认 https://cloud.langfuse.com] 自托管时改为自托管地址。
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ==============================================================================
# 十、ClawBot 微信互通（按需启用）
# ==============================================================================

# [可选/默认 false] 是否启用微信 iLink Bot；启用后在系统设置中扫码登录。
# Bot 登录状态保存在 saves/clawbot/state.json，不需要在这里填写 Bot Token。
CLAWBOT_ENABLED=false

# ==============================================================================
# 十一、前端和开发调试（可选）
# ==============================================================================

# [可选/默认 false] 前端是否使用 runs API 实验链路。
VITE_USE_RUNS_API=false
# [可选/默认 http://localhost] 后端访问宿主机 Docker API 的基础地址。
ZIXUETONG_DOCKER_API_BASE=http://localhost
